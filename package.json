{
  "name": "account-zcash-viewingkeys",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/publish-copilot.mjs && node scripts/build-zarvis-knowledge.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/publish-copilot.mjs && node scripts/build-zarvis-knowledge.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/build-zarvis-knowledge.test.mjs",
    "test:watch": "vitest",
    "test:copilot": "node --test scripts/publish-copilot.test.mjs && python3 -B -m unittest discover -s skills/zcg-copilot/tests",
    "probe": "tsx scripts/probe-node.ts",
    "import-ufvk": "tsx scripts/import-ufvk.ts",
    "import-zcg": "node --conditions=react-server --import tsx scripts/import-zcg.ts",
    "sync-ecosystem": "node scripts/sync-ecosystem.mjs",
    "test:ecosystem-sync": "node --test scripts/lib/ecosystem-collection.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "knowledge:build": "node scripts/build-zarvis-knowledge.mjs",
    "knowledge:check": "node scripts/build-zarvis-knowledge.mjs --check",
    "test:knowledge": "node --test scripts/build-zarvis-knowledge.test.mjs",
    "knowledge:sync": "python3 scripts/sync-zarvis-references.py",
    "eval:zarvis": "vitest run src/lib/zarvis/evaluation.test.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.185.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "libsodium-wrappers": "^0.8.4",
    "next": "16.2.9",
    "openai": "7.23.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "simple-icons": "^16.32.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}

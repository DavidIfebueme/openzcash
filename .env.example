# Copy to .env.local and fill in. NEVER put real secrets in this file.
# Everything here is names + placeholders only; .env.local is gitignored.

# ── Core (required to run) ────────────────────────────────────────────────
# Postgres connection string.
DATABASE_URL=postgres://USER@localhost:5432/openzcash

# Which ZCG public spreadsheet to mirror (Google Sheets file id).
ZCG_SHEET_ID=

# ── Admin (the write side; the public read side needs none of this) ───────
# Password for the /login admin session.
ADMIN_PASSWORD=
# HMAC key for signing session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=
# Bearer token guarding GET /api/cron/refresh. Generate: openssl rand -hex 32
CRON_SECRET=
# libsodium sealed-box keypair for treasury onboarding (base64).
ONBOARDING_PUBLIC_KEY=
ONBOARDING_SECRET_KEY=

# ── On-chain data (node-less: public lightwalletd + scanner) ──────────────
# lightwalletd endpoint. Port :443 is treated as TLS. e.g. zec.rocks:443
LWD_URL=zec.rocks:443
# ppf-scanner service for watch-only UFVK validation/derivation.
SCANNER_URL=
SCANNER_SECRET=

# ── Optional: self-hosted Zcash node (degrades gracefully if unset) ───────
# "mock" uses the built-in dataset; "real" uses the node RPC below.
ZCASH_GATEWAY=mock
# Zebra full node RPC (must listen on 0.0.0.0 for LAN access).
ZEBRA_RPC_URL=http://NODE_HOST:8232
ZEBRA_RPC_USER=
ZEBRA_RPC_PASSWORD=
# zallet wallet RPC (its own port, separate from Zebra).
ZALLET_RPC_URL=http://NODE_HOST:PORT
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=
ZALLET_ACCOUNT_UUID=
# zkool2 (zkool-graphql) — watch-only UFVK history + memos via GraphQL.
ZKOOL_GRAPHQL_URL=http://NODE_HOST:PORT/graphql
ZKOOL_JWT_TOKEN=

# Optional: fine-grained GitHub token (public repo read-only). Without it the
# live GitHub layer shares the host's unauthenticated 60/h per-IP budget.
GITHUB_TOKEN=

# ── Zarvis (optional; server-side only) ──────────────────────────────────
# Use a separate OpenAI project/key. Never use NEXT_PUBLIC_ for this secret.
OPENAI_API_KEY=
# Explicit provider selection. Grok uses XAI_API_KEY and model grok-4.7.
ZARVIS_PROVIDER=openai
XAI_API_KEY=
ZARVIS_ENABLED=false
ZARVIS_ORIGIN=https://openzcash.org
ZARVIS_MODEL=gpt-5-mini
ZARVIS_WEB_SEARCH=true
# Shared request caps in Postgres. These are not a dollar billing cap.
ZARVIS_DAILY_REQUEST_LIMIT=100
ZARVIS_HOURLY_REQUEST_LIMIT=30
# Optional temporary launch window. Explicit UTC expiry; active only during its final 24 hours.
# Pauses global/network question quotas until that instant, including production. Normal API costs apply.
# Example format: 2026-09-29T03:00:00.000Z. Leave empty for normal quotas.
ZARVIS_QUOTA_PAUSE_UNTIL=

# Optional local testing only; requires NODE_ENV=development and an HTTP loopback ZARVIS_ORIGIN.
# Skips request-count quotas without changing per-answer token or time limits. Ignored in production.
ZARVIS_LOCAL_UNLIMITED=false

# Development only: log aggregate call/token counts, never conversations.
ZARVIS_DIAGNOSTICS=false
